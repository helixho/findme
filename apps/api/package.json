{
  "name": "@findme/api",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "node ../../scripts/test.mjs all",
    "test:local": "node ../../scripts/test.mjs local",
    "test:db": "node ../../scripts/test.mjs db",
    "quality:exploration": "tsx scripts/exploration-quality-eval.ts",
    "av:dogfood": "node --env-file-if-exists=../../.env --import tsx scripts/av-dogfood.ts",
    "av:layers": "node --env-file-if-exists=../../.env --import tsx scripts/av-layers.ts",
    "av:layers:view": "node --import tsx scripts/av-layers-view.ts",
    "diagnostic:reason": "node --import tsx scripts/diagnostic-reasoning.ts",
    "av:coverage": "node --import tsx scripts/av-coverage.ts",
    "understanding:baseline": "node --env-file-if-exists=../../.env --import tsx scripts/understanding-baseline.ts",
    "owner-account:create": "node --env-file-if-exists=../../.env --import tsx scripts/owner-account.ts"
  },
  "dependencies": {
    "@findme/core": "workspace:*",
    "@findme/db": "workspace:*",
    "@findme/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "^0.4.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "openai": "^4.67.0",
    "pg": "8.16.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/pg": "8.15.5",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "4.1.12"
  }
}
