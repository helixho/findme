# Direct PostgreSQL URL for local Node development; Worker uses Hyperdrive bindings.
DATABASE_URL=postgresql://ROLE:PASSWORD@NEON_HOST/neondb?sslmode=require
# Optional alternative to DATABASE_URL; omit when unused (an empty value fails validation).
# DATABASE_URL_RUNTIME=postgresql://ROLE:PASSWORD@HOST/DB
# Direct/unpooled Neon URL for migrations and backups; never use Hyperdrive here.
DATABASE_URL_UNPOOLED=
DATABASE_URL_MIGRATION=
DB_POOL_MAX=3
DB_POOL_IDLE_TIMEOUT=30
APP_AUTH_MODE=static
APP_ACCESS_TOKEN=change_me_static_token
APP_LOGIN_PASSWORD=change_me_password
SESSION_TTL_DAYS=30
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
HOST=127.0.0.1
PORT=8000
BACKUP_DATABASE_URL=
RESTORE_DATABASE_URL=
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# M-X2 gateway endpoint override; omit this variable to use the configured DeepSeek provider endpoint.
# M_X2_BASE_URL=https://your-gateway.example
# 约束②:不固化具体型号。实施时按 https://api-docs.deepseek.com 最新型号填本地 .env。
# env.ts 必填(min(1)),启动前 .env 须给一个非空值(骨架阶段可填占位)。
DEEPSEEK_MODEL=

# This template is for Node legacy/static development, not account enablement.
# Mode-specific minimum: docs/implementation/development-environment.md
# Account URLs, auth settings and queue/budget examples: deployment/cloud-account.env.example
# Database tests: pnpm test:db provisions DATABASE_URL_TEST; do not copy production URLs.
# Private U3 owner/file adapter settings are frozen compatibility, not account zero-start requirements.

# Legacy static browser entry URL; configure on the target machine.
FINDME_APP_URL=
