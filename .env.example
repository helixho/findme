# Local development (scripts/dev.sh). Production uses runtime.env generated by scripts/install-deploy.sh.
# Model provider, key and budgets are configured in the App settings and stored in the database.
DATABASE_URL_RUNTIME=postgresql://findme_runtime_login:PASSWORD@127.0.0.1:5432/findme
DATABASE_URL_IDENTITY=postgresql://findme_identity_login:PASSWORD@127.0.0.1:5432/findme
DATABASE_URL_AUTH=postgresql://findme_auth_login:PASSWORD@127.0.0.1:5432/findme
ACCOUNT_BASE_URL=http://127.0.0.1:5174
ACCOUNT_TRUSTED_ORIGINS=http://127.0.0.1:5174
ACCOUNT_SECRET=replace_with_at_least_32_random_characters
FINDME_FILES_ROOT=./data/files
FINDME_STATIC_ROOT=./apps/app/dist
HOST=127.0.0.1
PORT=8000
