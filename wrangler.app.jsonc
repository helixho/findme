{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findme-app",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "app.findme.example.com", "custom_domain": true }],
  "assets": {
    "directory": "apps/app/dist",
    "not_found_handling": "single-page-application"
  }
}
