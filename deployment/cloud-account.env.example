# Example only. Never source this over the current runtime configuration.
APP_AUTH_MODE=account
VITE_APP_AUTH_MODE=account
VITE_CORE_API_BASE=https://your-findme-host.example
ACCOUNT_BASE_URL=https://your-findme-host.example
ACCOUNT_TRUSTED_ORIGINS=https://your-findme-host.example
ACCOUNT_REGISTRATION_ENABLED=0
ACCOUNT_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET_AT_LEAST_32_CHARS
# Separate credentials; membership in the corresponding NOLOGIN role, no BYPASSRLS, no table ownership.
DATABASE_URL_RUNTIME=postgres://findme_app_login:REPLACE@HOST/DB
DATABASE_URL_IDENTITY=postgres://findme_identity_login:REPLACE@HOST/DB
DATABASE_URL_AUTH=postgres://findme_auth_login:REPLACE@HOST/DB
# Optional configured transactional email delivery adapter: POST {to,subject,text}.
ACCOUNT_MAIL_ENDPOINT=https://your-private-mail-adapter.example/send
ACCOUNT_MAIL_TOKEN=REPLACE_IN_SECRET_STORE
# All real inference remains opt-in; per-job confirmation is still required in the App.
CLOUD_INFERENCE_ENABLED=0
CLOUD_PROFILE_CALL_LIMIT=0
CLOUD_JOB_CALL_LIMIT=4
CLOUD_MAX_OUTPUT_TOKENS=6000
CLOUD_TIMEOUT_MS=90000
CLOUD_ALLOW_DRAFT_FRAMEWORKS=0
CLOUD_FRAMEWORK_CALL_LIMIT=0
# Automatic conversation processing (ADR D26): rolling 24h operations per Profile; 0 keeps it off.
# Needs CLOUD_INFERENCE_ENABLED=1; each operation makes at most 4 model requests.
CORE_MODEL_DAILY_OPERATION_LIMIT=0
DEEPSEEK_API_KEY=REPLACE_IN_SECRET_STORE
DEEPSEEK_MODEL=CHOOSE_APPROVED_SERVER_MODEL
# Only for Node frontend/API → configured Cloudflare queue dispatcher.
CLOUD_QUEUE_DISPATCH_ENDPOINT=https://your-findme-host.example/internal/cloud-diagnostics/enqueue
CLOUD_QUEUE_DISPATCH_TOKEN=REPLACE_IN_SECRET_STORE
# Cloudflare uses FINDME_ACCOUNT_MODE=1 and three distinct Hyperdrive bindings instead of DB URL variables.
# API Worker bindings: HYPERDRIVE / HYPERDRIVE_IDENTITY / HYPERDRIVE_AUTH, FINDME_TASKS, and optional FINDME_BLOBS.
# Browser assets are deployed separately from apps/app using wrangler.app.jsonc.
