{
  "name": "helix-findme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:api": "pnpm --filter @findme/api dev",
    "dev:app": "pnpm --filter @findme/app dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node scripts/test.mjs all",
    "test:local": "node scripts/test.mjs local",
    "test:db": "node scripts/test.mjs db",
    "test:runner": "node --test scripts/test-runner.test.mjs scripts/native-runtime.test.mjs",
    "av:layers": "pnpm --filter @findme/api av:layers",
    "av:layers:view": "pnpm --filter @findme/api av:layers:view",
    "diagnostic:reason": "pnpm --filter @findme/api diagnostic:reason",
    "av:coverage": "pnpm --filter @findme/api av:coverage",
    "understanding:baseline": "pnpm --filter @findme/api understanding:baseline",
    "test:fast": "node scripts/test.mjs fast",
    "test:app": "node scripts/test.mjs app",
    "test:browser": "node scripts/test-browser.mjs all",
    "test:browser:synthetic": "node scripts/test-browser.mjs synthetic",
    "test:browser:real": "node scripts/test-browser.mjs real",
    "test:coverage:local": "node scripts/test.mjs coverage local",
    "test:coverage:db": "node scripts/test.mjs coverage db",
    "policy:inspect": "pnpm --filter @findme/api exec tsx scripts/policy-inspect.ts",
    "check:repo": "node scripts/check-repository.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "seroval": "1.6.11",
      "browserslist": "4.28.7",
      "immutable": "5.1.8",
      "undici": "7.30.1",
      "source-map-js": "1.2.2",
      "form-data": "4.0.6",
      "nanoid": "3.3.18",
      "brace-expansion@5.0.6": "5.0.12",
      "sharp": "0.35.5",
      "zod@^4": "4.6.6",
      "stylus>glob": "14.0.3",
      "postcss@^8": "8.5.32"
    },
    "packageExtensions": {
      "better-call@1.4.0": {
        "dependencies": {
          "zod": "^4.0.0"
        }
      }
    },
    "patchedDependencies": {
      "zod@3.25.76": "patches/zod@3.25.76.patch"
    }
  }
}
