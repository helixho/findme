{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findme",
  "main": "apps/api/src/cloudflare.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": []
  },
  "routes": [
    {
      "pattern": "findme.example.com",
      "custom_domain": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FINDME_TASKS",
        "queue": "findme-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "findme-tasks",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 30,
        "visibility_timeout_ms": 900000,
        "dead_letter_queue": "findme-tasks-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "vars": {
    "FINDME_AV_RUNTIME_HASH": "93f946837be5e18f989340a163976f5ad4b670793e54b98c573b4ea55e4bbf2b",
    "FINDME_AV_SOURCE_HASH": "db3058167e944a1c40787d2c7f93976f60d60f9d52331b6b112bab0c12e1b8b5",
    "APP_AUTH_MODE": "static",
    "M_X2_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-v4-flash"
  }
}
